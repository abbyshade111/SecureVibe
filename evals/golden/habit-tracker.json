          {
            "name": "title",
            "label": "Title",
            "type": "text",
            "required": true,
            "sensitive": false
          },
          {
            "name": "frequency",
            "label": "Frequency",
            "type": "choice",
            "required": false,
            "choices": [
              "daily",
              "weekly"
            ],
            "sensitive": false
          },
          {
            "name": "notes",
            "label": "Notes",
            "type": "longtext",
            "required": false,
            "sensitive": false
          }
        ],
        "access": "all-signed-in"
      }
    ],
    "keyFeatures": [
      "Tick off a habit for today",
      "See the current streak per habit"
    ]
