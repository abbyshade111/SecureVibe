{
  "app": {
    "name": "Habit Log",
    "description": "A simple page where I tick off daily habits and see streaks.",
    "category": "tracker",
    "entities": [
      {
        "name": "habit",
        "label": "Habit",
        "pluralLabel": "Habits",
