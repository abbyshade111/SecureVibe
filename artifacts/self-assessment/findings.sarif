              "name": "Dependency runs install scripts",
              "shortDescription": {
                "text": "Dependency runs install scripts"
              },
              "fullDescription": {
                "text": "A package in the lockfile declares an install script (hasInstallScript)."
              },
              "properties": {
                "tags": [
                  "deps",
                  "CWE-829"
                ],
                "security-severity": "0.5"
              }
            }
          ]
