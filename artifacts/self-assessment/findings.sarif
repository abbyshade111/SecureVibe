{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SecureVibe",
          "version": "0.1.0",
          "informationUri": "https://github.com/owasp/secure-by-design",
          "rules": [
            {
              "id": "dast.authz.anonymous-denied",
              "name": "Protected route reachable without signing in",
              "shortDescription": {
                "text": "Protected route reachable without signing in"
              },
              "fullDescription": {
                "text": "A route declared as requiring sign-in responded to an anonymous request with data or success."
              },
              "properties": {
                "tags": [
                  "dast",
                  "CWE-306"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "sast.hardcoded-secret",
              "name": "Secret written directly in the code",
              "shortDescription": {
                "text": "Secret written directly in the code"
              },
              "fullDescription": {
                "text": "A password, API key or signing secret appears as a literal string in a source file."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-798"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "sast.route-outside-registry",
              "name": "Route registered without defineRoute",
              "shortDescription": {
                "text": "Route registered without defineRoute"
              },
              "fullDescription": {
                "text": "A route is added with app.get / router.post directly instead of defineRoute."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-862"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "sast.fs-user-path",
              "name": "File read or written at a user-controlled path",
              "shortDescription": {
                "text": "File read or written at a user-controlled path"
              },
              "fullDescription": {
                "text": "A node:fs call receives a path that includes request data."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-22",
                  "CWE-73"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "sast.path-join-user-input",
              "name": "File path built from user input",
              "shortDescription": {
                "text": "File path built from user input"
              },
              "fullDescription": {
                "text": "path.join or path.resolve is called with a value from a request."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-22"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "sast.child-process-exec",
              "name": "The app runs operating system commands",
              "shortDescription": {
                "text": "The app runs operating system commands"
              },
              "fullDescription": {
                "text": "The code uses child_process (exec, spawn, execSync) to run commands on the computer."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-78"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "config.protected-files-unchanged",
              "name": "Protected files differ from the template",
              "shortDescription": {
                "text": "Protected files differ from the template"
              },
              "fullDescription": {
                "text": "One or more protected files (security modules, config, security tests, manifest, package files) do not match the hashes recorded at scaffold time."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-693"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "config.secrets-strength",
              "name": "A secret in .env is weak or a placeholder",
              "shortDescription": {
                "text": "A secret in .env is weak or a placeholder"
              },
              "fullDescription": {
                "text": "SESSION_SECRET, FIELD_KEYS or TOKEN_HMAC_KEY is shorter than 32 bytes or equals the .env.example placeholder."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-521",
                  "CWE-1392"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "config.package-json-unmodified",
              "name": "package.json was modified",
              "shortDescription": {
                "text": "package.json was modified"
              },
              "fullDescription": {
                "text": "package.json differs from the tested template version (new dependencies or changed scripts)."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1104"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "sast.helmet-disabled-csp",
              "name": "Content Security Policy disabled",
              "shortDescription": {
                "text": "Content Security Policy disabled"
              },
              "fullDescription": {
                "text": "helmet is configured with contentSecurityPolicy: false or the CSP directives were relaxed with 'unsafe-inline' or 'unsafe-eval'."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-693"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "sast.tls-reject-unauthorized-false",
              "name": "Certificate checking disabled",
              "shortDescription": {
                "text": "Certificate checking disabled"
              },
              "fullDescription": {
                "text": "The code sets rejectUnauthorized: false or NODE_TLS_REJECT_UNAUTHORIZED=0, turning off certificate verification for outbound connections."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-295"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secrets.password-assignment",
              "name": "Password written in a file",
              "shortDescription": {
                "text": "Password written in a file"
              },
              "fullDescription": {
                "text": "A variable named password (or similar) is assigned a literal value."
              },
              "properties": {
                "tags": [
                  "secrets",
                  "CWE-259"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "config.provenance-present",
              "name": "Provenance record is missing",
              "shortDescription": {
                "text": "Provenance record is missing"
              },
              "fullDescription": {
                "text": "securevibe.provenance.json is missing or unreadable."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "dast.input.proto-pollution",
              "name": "__proto__ in input not rejected",
              "shortDescription": {
                "text": "__proto__ in input not rejected"
              },
              "fullDescription": {
                "text": "A JSON body containing __proto__ or constructor.prototype keys was accepted."
              },
              "properties": {
                "tags": [
                  "dast",
                  "CWE-1321"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "sast.req-body-unvalidated",
              "name": "Request body used without validation",
              "shortDescription": {
                "text": "Request body used without validation"
              },
              "fullDescription": {
                "text": "A handler reads req.body directly instead of req.valid.body from a defineRoute schema."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-20"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "sast.fetch-outside-http-client",
              "name": "fetch() used outside the HTTP client",
              "shortDescription": {
                "text": "fetch() used outside the HTTP client"
              },
              "fullDescription": {
                "text": "Code calls the global fetch directly instead of outboundFetch from src/lib/http-client.ts."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-918"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "sast.timing-unsafe-compare",
              "name": "Secret compared with ===",
              "shortDescription": {
                "text": "Secret compared with ==="
              },
              "fullDescription": {
                "text": "A token, hash or secret is compared with === or ==, which stops at the first different character."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-208"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "sast.inline-script-in-view",
              "name": "Inline script without the CSP nonce",
              "shortDescription": {
                "text": "Inline script without the CSP nonce"
              },
              "fullDescription": {
                "text": "A template contains a <script> tag without nonce=\"<%= nonce %>\"."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-79"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "sast.href-from-data",
              "name": "Link address taken from data without a protocol check",
              "shortDescription": {
                "text": "Link address taken from data without a protocol check"
              },
              "fullDescription": {
                "text": "An href is set from a stored or user-provided value without checking it starts with http:// or https://."
              },
              "properties": {
                "tags": [
                  "sast",
                  "CWE-79"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "secrets.high-entropy-assignment",
              "name": "Random-looking value assigned to a secret-like name",
              "shortDescription": {
                "text": "Random-looking value assigned to a secret-like name"
              },
              "fullDescription": {
                "text": "A long, random-looking string is assigned to a variable named like key, secret, token or password."
              },
              "properties": {
                "tags": [
                  "secrets",
                  "CWE-798"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "docs.outside-services-documented",
              "name": "The outside services the app may contact are not documented",
              "shortDescription": {
                "text": "The outside services the app may contact are not documented"
              },
              "fullDescription": {
                "text": "docs/communications.md is missing, or does not list the hosts the app is allowed to contact."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.data-classes-documented",
              "name": "The kinds of information the app holds are not documented",
              "shortDescription": {
                "text": "The kinds of information the app holds are not documented"
              },
              "fullDescription": {
                "text": "docs/data-protection.md is missing, or does not cover the kinds of information the app was designed to hold and how long they are kept."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.dependency-updates-documented",
              "name": "How the app's packages are kept up to date is not documented",
              "shortDescription": {
                "text": "How the app's packages are kept up to date is not documented"
              },
              "fullDescription": {
                "text": "docs/dependencies.md is missing, or does not give the deadlines for applying security updates."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.logging-documented",
              "name": "What the app logs is not documented",
              "shortDescription": {
                "text": "What the app logs is not documented"
              },
              "fullDescription": {
                "text": "docs/logging.md is missing, or does not say where the log is kept and for how long."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.sign-in-rules-documented",
              "name": "The sign-in rules are not documented",
              "shortDescription": {
                "text": "The sign-in rules are not documented"
              },
              "fullDescription": {
                "text": "docs/SECURITY.md is missing, or does not describe the sign-in limits, the banned password words and the administrator's second step."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.session-times-documented",
