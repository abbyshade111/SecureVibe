                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "docs.validation-documented",
              "name": "The rules for what people may type are not documented",
              "shortDescription": {
                "text": "The rules for what people may type are not documented"
              },
              "fullDescription": {
                "text": "docs/validation.md is missing, empty, or does not cover every kind of record the app keeps."
              },
              "properties": {
                "tags": [
                  "config",
                  "CWE-1059"
                ],
                "security-severity": "3.0"
              }
            },
