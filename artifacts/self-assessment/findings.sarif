              "id": "external.semgrep.problem-based-packs.insecure-transport.js-node.bypass-tls-verification.bypass-tls-verification",
              "name": "Semgrep: bypass-tls-verification",
              "shortDescription": {
                "text": "Semgrep: bypass-tls-verification"
              },
              "fullDescription": {
                "text": "Checks for setting the environment variable NODE_TLS_REJECT_UNAUTHORIZED to 0, which disables TLS verification. This should only be used for debugging purposes. Setting the option rejectUnauthorized to false bypasses verification against the list of trusted CAs, which also leads to insecure transport. These options lead to vulnerability to MTM attacks, and should not be used."
              },
              "properties": {
                "tags": [
                  "external",
                  "CWE-319"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "lint.security/detect-unsafe-regex",
              "name": "A regular expression can take exponential time to match",
              "shortDescription": {
                "text": "A regular expression can take exponential time to match"
              },
              "fullDescription": {
                "text": "The pattern has nested repetition (e.g. (a+)+) that can force catastrophic backtracking on certain input."
              },
              "properties": {
                "tags": [
