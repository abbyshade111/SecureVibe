# Configuration for this app. Copy to .env (or run "npm run setup", which does it for you and fills in the secrets).
# Lines starting with # are comments. Every value can also be set as an environment variable.

# --- Where and how the app runs -------------------------------------------------------------------
# production (default) or development. "test" is only used by automated checks.
NODE_ENV=production
# Port to listen on. 0 picks a free port.
PORT=3000
# 0 = only this computer can reach the app (127.0.0.1). 1 = other devices on the local network can reach it (0.0.0.0).
BIND_LAN=0
# off = plain http (only safe on this computer) | selfsigned = https with certs/ from "npm run gen-cert" | proxy = behind a TLS reverse proxy
TLS_MODE=off
# Number of trusted reverse proxies in front of the app. Leave 0 unless TLS_MODE=proxy.
TRUST_PROXY_HOPS=0
# Folder for the database, uploads, outgoing mail and the log. Created with owner-only permissions.
DATA_DIR=./data
# Shown in page titles and emails.
APP_NAME=My App
# The colour scheme: calm, warm, forest or contrast. Colours only; every one is checked for readability.
APP_THEME=calm

# --- Secrets (generated by "npm run setup"; never share them, never commit .env) --------------------
# Each must be at least 32 random bytes. The app refuses to start while a placeholder is still here.
SESSION_SECRET=__generate_with_npm_run_setup__
FIELD_KEYS=1:__generate_with_npm_run_setup__
ACTIVE_FIELD_KEY=1
TOKEN_HMAC_KEY=__generate_with_npm_run_setup__

# --- Sign-in policy ---------------------------------------------------------------------------------
# A sign-in ends after this many minutes without activity, and always after this many hours.
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8
# How many devices may be signed in to one account at the same time (the oldest is signed out).
SESSION_MAX_CONCURRENT=5
# 1 = administrators must set up one-time codes (authenticator app) before they can use the app.
ADMIN_MFA_REQUIRED=1
# 1 = every user may set up one-time codes.
USER_MFA_AVAILABLE=1
# open | invite-only | admin-created
REGISTRATION_MODE=admin-created
# Email address of the first administrator (used by "npm run setup").
ADMIN_EMAIL=

# --- Rate limits (attempts per window; see docs/SECURITY.md) ----------------------------------------
RATE_LIMIT_GENERAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_MFA_PER_ACCOUNT=5
RATE_LIMIT_REGISTRATION_PER_HOUR=3
RATE_LIMIT_RESET_PER_ACCOUNT=3
RATE_LIMIT_RESET_PER_IP=10
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_API_KEY_PER_MIN=120

# --- Talking to other services ----------------------------------------------------------------------
# Comma-separated host[:port] list the app may call. Empty = the app never calls out.
OUTBOUND_ALLOWED_HOSTS=
# Outgoing email. Leave SMTP_URL empty to write messages to DATA_DIR/outbox instead of sending them.
SMTP_URL=
MAIL_FROM=

# --- File uploads (only used when the uploads feature is on) ----------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf

# Uploaded files are checked for viruses before they are kept, and a file that cannot be checked is refused
# rather than stored unchecked. The default is the ClamAV daemon on this machine, so nothing here needs setting
# if clamd is running on its usual socket. Set MALWARE_SCANNER=off to switch uploads off entirely -- it does not
# mean "accept anything", it means files are not accepted at all.
# MALWARE_SCANNER=clamd
# CLAMD_SOCKET=/opt/homebrew/var/run/clamav/clamd.sock
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=30000
UPLOAD_USER_QUOTA_BYTES=209715200

# --- AI assistant (only used when the AI feature is on) ---------------------------------------------
# The API key comes from the environment only and is never written to disk by the app.
# ANTHROPIC_API_KEY=
# The assistant can run on OpenAI or Google instead: set AI_PROVIDER=openai or google, the matching key below,
# and an AI_MODEL of that service (for example gpt-5-mini or gemini-2.5-flash). Web search is Anthropic-only.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
AI_ENABLED=1
AI_MODEL=claude-opus-5
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1024
AI_USER_DAILY_TOKENS=200000
AI_MODERATION=0
# 1 = the assistant may look things up on the web. The search runs at the model provider (Anthropic), so the app
# itself still contacts nothing but the provider. Answers then include a short list of sources. Each search costs
# a little extra on your provider bill, and an answer takes longer (up to two minutes).
AI_WEB_SEARCH=0
# Most searches an answer may use.
AI_WEB_SEARCH_MAX_USES=5
# Comma-separated sites results may come from. Empty = the whole web. For subjects where only trustworthy sources
# will do, list them, for example:
# AI_WEB_SEARCH_DOMAINS=pubmed.ncbi.nlm.nih.gov,medlineplus.gov,who.int,cdc.gov,nih.gov,cochrane.org
AI_WEB_SEARCH_DOMAINS=
# Score (0 to 1) above which the moderation check refuses a question or an answer.
AI_MODERATION_THRESHOLD=0.8
# Leave unset to use Anthropic. "mock" answers from a built-in, offline stand-in and is only for tests.
# AI_PROVIDER=

# --- Logging and records ----------------------------------------------------------------------------
# trace, debug, info, warn, error, fatal, or silent to turn logging off entirely.
LOG_LEVEL=info
# Defaults to DATA_DIR/app.log
LOG_FILE=
# Security events are kept for at least this many days (one year minimum is recommended).
AUDIT_RETENTION_DAYS=400
# When set, records older than this many months are deleted or anonymised as described in docs/data-retention.md.
RETENTION_MONTHS=

# --- Development only --------------------------------------------------------------------------------
# 1 = mount the reference "notes" feature (never in production).
EXAMPLE_FEATURE=0
