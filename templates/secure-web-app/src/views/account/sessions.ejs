<section class="card">
  <h1>Where you are signed in</h1>
  <p>Each row is a device or browser that is signed in to your account. Sign out any you do not recognize.</p>
  <table class="table">
    <thead>
      <tr><th>Signed in</th><th>Last used</th><th>Address</th><th></th></tr>
    </thead>
    <tbody>
      <% for (const s of sessions) { %>
        <tr>
          <td><%= formatDate(s.createdAt) %></td>
          <td><%= formatDate(s.lastSeenAt) %></td>
          <td><%= s.ip || 'unknown' %></td>
          <td>
            <% if (s.current) { %>
              <span class="tag">This device</span>
            <% } else { %>
              <form method="post" action="/account/sessions/<%= s.idPrefix %>/revoke" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="button button-small button-secondary">Sign out</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <form method="post" action="/account/sessions/revoke-others">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="button button-danger">Sign out everywhere else</button>
  </form>
  <p class="muted"><a href="/account">Back to your account</a></p>
</section>
