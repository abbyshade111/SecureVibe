<section class="card narrow">
  <h1><%= note ? 'Edit note' : 'New note' %></h1>
  <% if (errors._) { %><p class="form-error" role="alert"><%= errors._ %></p><% } %>
  <form method="post" action="<%= note ? '/notes/' + note.id : '/notes' %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (note) { %><input type="hidden" name="updatedAt" value="<%= note.updatedAt %>"><% } %>
    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required maxlength="120" value="<%= values.title || '' %>">
      <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
    </div>
    <div class="field">
      <label for="body">Text</label>
      <textarea id="body" name="body" rows="8" maxlength="10000"><%= values.body || '' %></textarea>
      <% if (errors.body) { %><p class="field-error"><%= errors.body %></p><% } %>
    </div>
    <button type="submit" class="button">Save</button>
    <a class="button button-secondary" href="<%= note ? '/notes/' + note.id : '/notes' %>">Cancel</a>
  </form>
</section>
