<section class="card narrow">
  <h1>Sign in</h1>
  <% if (errors._) { %><p class="form-error" role="alert"><%= errors._ %></p><% } %>
  <form method="post" action="/login" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (values.next) { %><input type="hidden" name="next" value="<%= values.next %>"><% } %>
    <div class="field">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="username" required value="<%= values.email || '' %>">
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
    </div>
    <button type="submit" class="button">Sign in</button>
  </form>
  <p class="muted"><a href="/forgot-password">Forgotten your password?</a></p>
</section>
