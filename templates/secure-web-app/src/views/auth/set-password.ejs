<section class="card narrow">
  <h1><%= title %></h1>
  <% if (errors._) { %><p class="form-error" role="alert"><%= errors._ %></p><% } %>
  <form method="post" action="<%= action %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required>
      <p class="hint">At least 12 characters. A short sentence you will remember works well.</p>
      <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
    </div>
    <div class="field">
      <label for="passwordConfirm">Type it again</label>
      <input id="passwordConfirm" name="passwordConfirm" type="password" autocomplete="new-password">
      <% if (errors.passwordConfirm) { %><p class="field-error"><%= errors.passwordConfirm %></p><% } %>
    </div>
    <button type="submit" class="button">Save password</button>
  </form>
</section>
