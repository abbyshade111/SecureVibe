<section class="card narrow">
  <h1>Create an account</h1>
  <% if (errors._) { %><p class="form-error" role="alert"><%= errors._ %></p><% } %>
  <form method="post" action="/register" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="name">Your name (optional)</label>
      <input id="name" name="name" type="text" autocomplete="name" value="<%= values.name || '' %>">
      <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
    </div>
    <div class="field">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="username" required value="<%= values.email || '' %>">
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required>
      <p class="hint">At least 12 characters. A short sentence you will remember works well. Any characters are allowed.</p>
      <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
    </div>
    <div class="field">
      <label for="passwordConfirm">Type the password again</label>
      <input id="passwordConfirm" name="passwordConfirm" type="password" autocomplete="new-password" required>
      <% if (errors.passwordConfirm) { %><p class="field-error"><%= errors.passwordConfirm %></p><% } %>
    </div>
    <button type="submit" class="button">Create my account</button>
  </form>
</section>
