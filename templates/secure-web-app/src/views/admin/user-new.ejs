<section class="card narrow">
  <h1>Invite someone</h1>
  <p>The person receives an invitation link and chooses their own password. Nobody ever needs to send a password by email or chat.</p>
  <% if (errors._) { %><p class="form-error" role="alert"><%= errors._ %></p><% } %>
  <form method="post" action="/admin/users" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" required value="<%= values.email || '' %>">
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
    </div>
    <div class="field">
      <label for="name">Name (optional)</label>
      <input id="name" name="name" type="text" value="<%= values.name || '' %>">
      <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
    </div>
    <div class="field">
      <label for="role">Role</label>
      <select id="role" name="role">
        <% for (const r of roles) { %>
          <option value="<%= r.name %>" <%= r.name === (values.role || '') ? 'selected' : '' %>><%= r.label %></option>
        <% } %>
      </select>
      <% if (errors.role) { %><p class="field-error"><%= errors.role %></p><% } %>
    </div>
    <button type="submit" class="button">Create invitation</button>
    <a class="button button-secondary" href="/admin/users">Cancel</a>
  </form>
</section>
