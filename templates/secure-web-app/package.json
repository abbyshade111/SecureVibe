{
  "name": "secure-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "A hardened web application baseline generated by SecureVibe. Runs locally with Node.js; no build step.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/preflight.mjs && node --experimental-strip-types src/server.ts",
    "setup": "node scripts/preflight.mjs && node --experimental-strip-types scripts/setup.ts",
    "test": "node --experimental-strip-types --test tests/",
    "typecheck": "tsc -p tsconfig.json",
    "docs:build": "node --experimental-strip-types scripts/docs-build.ts",
    "audit:verify": "node --experimental-strip-types scripts/audit-verify.ts",
    "rotate-field-key": "node --experimental-strip-types scripts/rotate-field-key.ts",
    "routes:export": "node --experimental-strip-types scripts/routes-export.ts",
    "gen-cert": "node --experimental-strip-types scripts/gen-cert.ts",
    "rotate:keys": "node --experimental-strip-types scripts/rotate-keys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "busboy": "^1.6.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
