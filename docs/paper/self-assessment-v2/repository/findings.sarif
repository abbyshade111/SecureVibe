          "message": {
            "text": "Semgrep Finding: ai.ai-best-practices.agent-unbounded-loop.agent-unbounded-loop.agent-unbounded-loop-python LLM API call inside a `while True` loop without a break condition. This creates an unbounded agent loop that may run indefinitely, consuming API credits and resources. Add a break condition, iteration counter, or timeout to prevent runaway execution."
          },
          "ruleId": "semgrep.ai.ai-best-practices.agent-unbounded-loop.agent-unbounded-loop.agent-unbounded-loop-python"
        },
