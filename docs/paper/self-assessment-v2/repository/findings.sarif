                }
              }
            }
          ],
          "message": {
            "text": "Semgrep Finding: ai.ai-best-practices.mcp-unsanitized-return.mcp-unsanitized-return.mcp-unsanitized-return-python External HTTP response data flows directly into an MCP tool return value without sanitization. Untrusted API responses may contain prompt injection payloads or malicious content that could manipulate the LLM. Sanitize or validate external data before returning it from MCP tools."
          },
          "ruleId": "semgrep.ai.ai-best-practices.mcp-unsanitized-return.mcp-unsanitized-return.mcp-unsanitized-return-python"
        },
