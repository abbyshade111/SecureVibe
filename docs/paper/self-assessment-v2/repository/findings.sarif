          ],
          "message": {
            "text": "Semgrep Finding: ai.ai-best-practices.mcp-credential-in-response.mcp-credential-in-response.mcp-credential-in-response-python MCP tool returns a dictionary containing credential-like keys such as api_key, password, secret, or token. Exposing credentials in tool responses risks leaking them to the LLM context or logs. Remove sensitive fields before returning data from MCP tools."
          },
          "ruleId": "semgrep.ai.ai-best-practices.mcp-credential-in-response.mcp-credential-in-response.mcp-credential-in-response-python"
        },
