      "tool": {
        "driver": {
          "informationUri": "https://github.com/abbyshade111/SecureVibe",
          "name": "sv",
          "properties": {
            "commit": "84dcbd47db747b8114d071485bf62c43846b7c8d"
          },
          "rules": [
            {
              "fullDescription": {
                "text": "If any part of the path comes from a request, a name like ../../etc/passwd reads or overwrites a file outside the folder the app meant to use."
              },
              "help": {
                "text": "Keep user-submitted file names out of file paths: store files under names the app generates, and look them up by id. Where a submitted name has to be used, reduce it to a bare name (secure_filename in Flask, path.basename in Node) and check that the resolved path is still inside the folder it should be in."
              },
              "id": "ast.file-path-from-value",
              "name": "ast.file-path-from-value",
              "properties": {
                "requirements": [
                  "V5.3.2"
                ],
                "tags": [
                  "CWE-22",
                  "CWE-73"
                ]
              },
              "shortDescription": {
                "text": "A file is opened at a path built from a value"
              }
            },
            {
              "fullDescription": {
                "text": "The model behind the app can change on the provider's schedule with no change to your code, so nothing prompts anyone to test the new one for safety before users meet it."
              },
              "help": {
                "text": "Name a dated model version (for example `gpt-4o-2024-08-06` rather than `chatgpt-4o-latest`), and when you move to a new one, do it on purpose and re-run your checks."
              },
              "id": "ast.floating-model-name",
              "name": "ast.floating-model-name",
              "properties": {
                "requirements": [
                  "C3.2.3"
                ],
                "tags": [
                  "CWE-1357"
                ]
              },
              "shortDescription": {
                "text": "A hosted model is asked for by a name that moves"
              }
            },
            {
              "fullDescription": {
                "text": "A semicolon or a backtick in the wrong place turns one command into two, and the second one is whatever the attacker wanted."
              },
              "help": {
                "text": "Pass the program and its arguments as a list instead of a string, so the shell never parses them. Where a shell is genuinely needed, validate the value against a fixed set first."
              },
              "id": "ast.shell-command",
              "name": "ast.shell-command",
              "properties": {
                "requirements": [
                  "V1.2.5"
                ],
                "tags": [
                  "CWE-78"
                ]
              },
              "shortDescription": {
                "text": "A shell command is built from a value"
              }
            },
            {
              "fullDescription": {
                "text": "Anything that relies on the hash to tell two things apart, or to prove something was not changed, can be fooled by somebody who builds a second input with the same hash. Used for passwords, both are also fast enough to guess through quickly."
              },
              "help": {
                "text": "Use SHA-256 or stronger for integrity and signatures, and a password hashing function (Argon2id, scrypt, bcrypt) for passwords. If this hash is only a cache key or a file checksum with no security purpose, say so where it is used; Python lets you pass usedforsecurity=False."
              },
              "id": "ast.weak-hash-function",
              "name": "ast.weak-hash-function",
              "properties": {
                "requirements": [
                  "V11.4.1"
                ],
                "tags": [
                  "CWE-328",
                  "CWE-327"
                ]
              },
              "shortDescription": {
                "text": "A disallowed hash function is used"
              }
            },
            {
              "fullDescription": {
                "text": "If the package or image is taken over or replaced, the next start runs the new code with the app's access to its tools and data, and nothing records that it changed."
              },
              "help": {
                "text": "Name an exact version (`package@1.2.3` for npx, `package==1.2.3` for uvx), or better, add the server to the app's own dependencies and lockfile so its version and checksum are recorded and checked on install."
              },
              "id": "config.mcp-server-unpinned",
              "name": "config.mcp-server-unpinned",
              "properties": {
                "requirements": [
                  "C10.1.1"
                ],
                "tags": [
                  "CWE-494",
                  "CWE-829"
                ]
              },
              "shortDescription": {
                "text": "An MCP server is downloaded fresh, at whatever version is newest, every time it starts"
              }
            },
            {
              "fullDescription": {
                "text": "Anyone who can read the code — or the history it is kept in — has the credential."
              },
              "help": {
                "text": "Move the value into the app's environment or secret store, and change the credential: anything committed should be treated as known."
              },
              "id": "secrets.credential-assignment",
              "name": "secrets.credential-assignment",
              "properties": {
                "requirements": [
                  "V13.3.1",
                  "V13.2.3",
                  "SBD-AC-05"
                ],
                "tags": [
                  "CWE-798",
                  "CWE-259"
                ]
              },
              "shortDescription": {
                "text": "A value that looks like a credential is written into the code (`password`)"
              }
            },
            {
              "fullDescription": {
                "text": "It may be a valid access token for a service; whoever has it can act as its owner until it expires."
              },
              "help": {
                "text": "Remove the token from the file. Generate tokens at test/run time instead of committing them."
              },
              "id": "secrets.jwt",
              "name": "secrets.jwt",
              "properties": {
