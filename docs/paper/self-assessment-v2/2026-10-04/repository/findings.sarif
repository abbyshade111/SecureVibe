      "tool": {
        "driver": {
          "informationUri": "https://github.com/abbyshade111/SecureVibe",
          "name": "sv",
          "properties": {
            "commit": "84dcbd47db747b8114d071485bf62c43846b7c8d"
          },
          "rules": [
            {
              "fullDescription": {
                "text": "If any part of that value can be influenced from outside, whoever influences it chooses what the app does next."
              },
              "help": {
                "text": "Work out what the code is actually for. A lookup table, a match on a fixed set of names, or a small parser will do the job without running text as code."
              },
              "id": "ast.dynamic-code-execution",
              "name": "ast.dynamic-code-execution",
              "properties": {
                "requirements": [
                  "V1.3.2"
                ],
                "tags": [
                  "CWE-95",
                  "CWE-94"
                ]
              },
              "shortDescription": {
                "text": "Code is built at run time and executed"
              }
            },
            {
              "fullDescription": {
                "text": "If any part of the path comes from a request, a name like ../../etc/passwd reads or overwrites a file outside the folder the app meant to use."
              },
              "help": {
                "text": "Keep user-submitted file names out of file paths: store files under names the app generates, and look them up by id. Where a submitted name has to be used, reduce it to a bare name (secure_filename in Flask, path.basename in Node) and check that the resolved path is still inside the folder it should be in."
              },
              "id": "ast.file-path-from-value",
              "name": "ast.file-path-from-value",
              "properties": {
                "requirements": [
                  "V5.3.2"
                ],
                "tags": [
                  "CWE-22",
                  "CWE-73"
                ]
              },
              "shortDescription": {
                "text": "A file is opened at a path built from a value"
              }
            },
            {
              "fullDescription": {
                "text": "The model behind the app can change on the provider's schedule with no change to your code, so nothing prompts anyone to test the new one for safety before users meet it."
              },
              "help": {
                "text": "Name a dated model version (for example `gpt-4o-2024-08-06` rather than `chatgpt-4o-latest`), and when you move to a new one, do it on purpose and re-run your checks."
              },
              "id": "ast.floating-model-name",
              "name": "ast.floating-model-name",
              "properties": {
                "requirements": [
                  "C3.2.3"
                ],
                "tags": [
                  "CWE-1357"
                ]
              },
              "shortDescription": {
                "text": "A hosted model is asked for by a name that moves"
              }
            },
            {
              "fullDescription": {
                "text": "If the destination comes from the request, as a ?next= parameter usually does, a link on the app's own domain can send somebody to a lookalike sign-in page on another domain, and the address they clicked was genuine."
              },
              "help": {
                "text": "Redirect only to the app's own routes, built with its router (url_for, reverse, a Rails _path helper), or check the destination against a short list of allowed hosts. For a return-to address, accept only a path that starts with a single / and not //."
              },
              "id": "ast.open-redirect",
              "name": "ast.open-redirect",
              "properties": {
                "requirements": [
                  "V3.7.2"
                ],
                "tags": [
                  "CWE-601"
                ]
              },
              "shortDescription": {
                "text": "The app redirects to a destination built from a value"
              }
            },
            {
              "fullDescription": {
                "text": "A semicolon or a backtick in the wrong place turns one command into two, and the second one is whatever the attacker wanted."
              },
              "help": {
                "text": "Pass the program and its arguments as a list instead of a string, so the shell never parses them. Where a shell is genuinely needed, validate the value against a fixed set first."
              },
              "id": "ast.shell-command",
              "name": "ast.shell-command",
              "properties": {
                "requirements": [
                  "V1.2.5"
                ],
                "tags": [
                  "CWE-78"
                ]
              },
              "shortDescription": {
                "text": "A shell command is built from a value"
              }
            },
            {
              "fullDescription": {
                "text": "Whatever ends up inside the backticks is run by a shell, so a semicolon in someone's input starts a second command with the app's own permissions."
              },
              "help": {
                "text": "Run the program directly with its arguments as a list, rather than building one string for a shell to pull apart."
              },
              "id": "ast.shell-command-backticks",
              "name": "ast.shell-command-backticks",
              "properties": {
                "requirements": [
                  "V1.2.5"
                ],
                "tags": [
                  "CWE-78"
                ]
              },
              "shortDescription": {
                "text": "A command is run with backticks, built from text"
              }
            },
            {
              "fullDescription": {
                "text": "A quote in someone's name is enough to change what the query does, and a deliberate one can read or delete any table the app can reach."
              },
              "help": {
                "text": "Send the query with placeholders and pass the values alongside it. Every database library supports this, and it is shorter than building the string."
              },
              "id": "ast.sql-built-by-hand",
              "name": "ast.sql-built-by-hand",
              "properties": {
                "requirements": [
                  "V1.2.4"
                ],
                "tags": [
                  "CWE-89"
                ]
              },
              "shortDescription": {
                "text": "A database query is built by joining text together"
              }
            },
            {
              "fullDescription": {
                "text": "Reading the data is enough to run code: the attacker does not need the app to use the result, only to load it."
              },
              "help": {
                "text": "Use the safe reader — yaml.safe_load rather than yaml.load — and prefer a format that carries data only, such as JSON, for anything that arrives from outside."
              },
              "id": "ast.unsafe-deserialization",
              "name": "ast.unsafe-deserialization",
              "properties": {
                "requirements": [
                  "V1.5.2"
                ],
                "tags": [
                  "CWE-502"
                ]
              },
              "shortDescription": {
                "text": "Data from outside is turned back into objects unsafely"
              }
            },
            {
              "fullDescription": {
                "text": "ECB leaves the shape of the data visible through the encryption, and the retired ciphers can be broken or have known practical attacks, so the encrypted data is less private than it looks."
              },
              "help": {
                "text": "Use AES with GCM (or ChaCha20-Poly1305) through your language's high-level library, which chooses the mode and the nonce for you. In Java, always name the mode: Cipher.getInstance(\"AES\") quietly means ECB."
              },
              "id": "ast.weak-cipher",
              "name": "ast.weak-cipher",
              "properties": {
                "requirements": [
                  "V11.3.1",
                  "V11.3.2"
                ],
                "tags": [
                  "CWE-327"
                ]
              },
              "shortDescription": {
                "text": "A cipher or block mode that is not approved is used"
              }
            },
            {
              "fullDescription": {
                "text": "Anything that relies on the hash to tell two things apart, or to prove something was not changed, can be fooled by somebody who builds a second input with the same hash. Used for passwords, both are also fast enough to guess through quickly."
              },
              "help": {
                "text": "Use SHA-256 or stronger for integrity and signatures, and a password hashing function (Argon2id, scrypt, bcrypt) for passwords. If this hash is only a cache key or a file checksum with no security purpose, say so where it is used; Python lets you pass usedforsecurity=False."
              },
              "id": "ast.weak-hash-function",
              "name": "ast.weak-hash-function",
              "properties": {
                "requirements": [
                  "V11.4.1"
                ],
                "tags": [
                  "CWE-328",
                  "CWE-327"
                ]
              },
              "shortDescription": {
                "text": "A disallowed hash function is used"
              }
            },
            {
              "fullDescription": {
                "text": "Anyone who gets hold of what the key protects, such as an encrypted backup, an export, or a stored hash, can try guesses at the password quickly on ordinary hardware, and most people's passwords fall to a fast guesser."
              },
              "help": {
                "text": "Raise the number of rounds to at least 600,000 for PBKDF2 with SHA-256 (210,000 with SHA-512), or use a password hashing function made for this, such as Argon2id or scrypt. Keep the count where it can be raised later without breaking what was already stored."
              },
              "id": "ast.weak-password-key-derivation",
              "name": "ast.weak-password-key-derivation",
              "properties": {
                "requirements": [
                  "V11.4.4"
                ],
                "tags": [
                  "CWE-916"
                ]
              },
              "shortDescription": {
                "text": "A key is made from a password with too few rounds of work"
              }
            },
            {
              "fullDescription": {
                "text": "If the package or image is taken over or replaced, the next start runs the new code with the app's access to its tools and data, and nothing records that it changed."
              },
              "help": {
                "text": "Name an exact version (`package@1.2.3` for npx, `package==1.2.3` for uvx), or better, add the server to the app's own dependencies and lockfile so its version and checksum are recorded and checked on install."
              },
              "id": "config.mcp-server-unpinned",
              "name": "config.mcp-server-unpinned",
              "properties": {
                "requirements": [
                  "C10.1.1"
                ],
                "tags": [
                  "CWE-494",
                  "CWE-829"
                ]
              },
              "shortDescription": {
                "text": "An MCP server is downloaded fresh, at whatever version is newest, every time it starts"
              }
            },
            {
              "fullDescription": {
                "text": "The inventory of third-party libraries this app ships is then a list of what was asked for rather than what is installed, so nobody can say whether a known vulnerability applies to it — and a component that is compromised upstream arrives on the next install without anything changing here."
              },
              "help": {
                "text": "Install once and commit the lockfile that produces, then install from it from then on."
              },
              "id": "config.versions-pinned",
              "name": "config.versions-pinned",
              "properties": {
                "requirements": [
                  "V15.1.2"
                ],
                "tags": [
                  "CWE-1104"
                ]
              },
              "shortDescription": {
                "text": "npm in crates/sv-scan/tests/fixtures/unpinned-npm/ and Python in crates/sv-scan/tests/fixtures/unpinned-python/ and Ruby in crates/sv-check/tests/fixtures/suppressed/brakeman-app/ and Go in crates/sv-check/tests/fixtures/suppressed/gosec-app/ do not pin the versions they install"
              }
            },
            {
              "fullDescription": {
                "text": "A bill of materials is worth the completeness of its list. Asked whether a compromised version of some library is in this app, nobody could answer from this document."
              },
              "help": {
                "text": "Commit a lockfile for every ecosystem in use, and install from it."
              },
              "id": "sbom.incomplete",
              "name": "sbom.incomplete",
              "properties": {
                "requirements": [
                  "V15.1.2"
                ],
                "tags": [
                  "CWE-1104"
                ]
              },
              "shortDescription": {
                "text": "The list of what this app ships is not complete"
              }
            },
            {
              "fullDescription": {
                "text": "Combined with its secret key it gives access to your cloud account."
              },
              "help": {
                "text": "Deactivate the key in AWS IAM and load credentials from the environment instead."
              },
              "id": "secrets.aws-access-key",
              "name": "secrets.aws-access-key",
              "properties": {
                "requirements": [
                  "V13.3.1",
                  "SBD-AC-05"
                ],
                "tags": [
                  "CWE-798"
                ]
              },
              "shortDescription": {
                "text": "AWS access key ID found in a file"
              }
            },
            {
              "fullDescription": {
                "text": "Anyone who can read the code — or the history it is kept in — has the credential."
              },
              "help": {
                "text": "Move the value into the app's environment or secret store, and change the credential: anything committed should be treated as known."
              },
              "id": "secrets.credential-assignment",
              "name": "secrets.credential-assignment",
              "properties": {
                "requirements": [
                  "V13.3.1",
                  "V13.2.3",
                  "SBD-AC-05"
                ],
                "tags": [
                  "CWE-798",
                  "CWE-259"
                ]
              },
              "shortDescription": {
                "text": "A value that looks like a credential is written into the code (`password`)"
              }
            },
            {
              "fullDescription": {
                "text": "It may be a valid access token for a service; whoever has it can act as its owner until it expires."
              },
              "help": {
                "text": "Remove the token from the file. Generate tokens at test/run time instead of committing them."
              },
              "id": "secrets.jwt",
              "name": "secrets.jwt",
              "properties": {
                "requirements": [
                  "V13.3.1",
                  "SBD-AC-05"
                ],
                "tags": [
                  "CWE-798"
                ]
              },
              "shortDescription": {
                "text": "JSON Web Token found in a file"
              }
            },
            {
              "fullDescription": {
                "text": "A private key lets an attacker impersonate your server or decrypt its traffic."
              },
              "help": {
                "text": "Remove the key from the file, regenerate it, and keep private keys only in certs/ with restrictive permissions."
              },
              "id": "secrets.private-key-block",
              "name": "secrets.private-key-block",
              "properties": {
                "requirements": [
                  "V11.1.1",
                  "V13.3.1",
                  "SBD-AC-05"
                ],
                "tags": [
                  "CWE-321"
                ]
              },
              "shortDescription": {
                "text": "Private key found in a file"
              }
            }
          ],
          "version": "0.1.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}