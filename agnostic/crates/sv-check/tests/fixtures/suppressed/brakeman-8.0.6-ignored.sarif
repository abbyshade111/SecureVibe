{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Brakeman",
          "informationUri": "https://brakemanscanner.org",
          "semanticVersion": "8.0.6",
          "rules": [
            {
              "id": "BRAKE0000",
              "name": "SQL/SQL Injection",
              "fullDescription": {
                "text": "Check for SQL injection."
              },
              "helpUri": "https://brakemanscanner.org/docs/warning_types/sql_injection/",
              "help": {
                "text": "More info: https://brakemanscanner.org/docs/warning_types/sql_injection/.",
                "markdown": "[More info](https://brakemanscanner.org/docs/warning_types/sql_injection/)."
              },
              "properties": {
                "tags": [
                  "SQL"
                ]
              }
            },
            {
              "id": "BRAKE0007",
              "name": "ForgerySetting/Cross-Site Request Forgery",
              "fullDescription": {
                "text": "Verifies that protect_from_forgery is enabled in direct subclasses of ActionController::Base."
              },
              "helpUri": "https://brakemanscanner.org/docs/warning_types/cross-site_request_forgery/",
              "help": {
                "text": "More info: https://brakemanscanner.org/docs/warning_types/cross-site_request_forgery/.",
                "markdown": "[More info](https://brakemanscanner.org/docs/warning_types/cross-site_request_forgery/)."
              },
              "properties": {
                "tags": [
                  "ForgerySetting"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "BRAKE0000",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Possible SQL injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/controllers/notes_controller.rb",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "suppressions": [
            {
              "kind": "external",
              "justification": "Checked by hand.",
              "location": {
                "physicalLocation": {
                  "artifactLocation": {
                    "uri": "config/brakeman.ignore",
                    "uriBaseId": "%SRCROOT%"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "BRAKE0007",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "`protect_from_forgery` should be called in `ApplicationController`."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/controllers/application_controller.rb",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ],
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "Base path for application"
          }
        }
      }
    }
  ]
}