    {
      "id": "ast.unsafe-deserialization",
      "title": "Data from outside is turned back into objects unsafely",
      "severity": "high",
      "confidence": "high",
      "requirementIds": [
        "V1.5.2"
      ],
      "cwe": [
        "CWE-502"
      ],
      "description": "A format that can describe arbitrary objects is being read with the reader that builds them.",
      "impact": "Reading the data is enough to run code: the attacker does not need the app to use the result, only to load it.",
      "fix": "Use the safe reader — yaml.safe_load rather than yaml.load — and prefer a format that carries data only, such as JSON, for anything that arrives from outside.",
      "literalArgumentIsSafe": false,
      "queries": {
        "python": "(call function: (attribute object: (identifier) @mod attribute: (identifier) @fn)) @hit",
        "ruby": "(call receiver: (constant) @mod method: (identifier) @fn) @hit",
        "php": "(function_call_expression function: (name) @fn\n                          arguments: (arguments . (argument (_) @arg))) @hit",
        "java": "(method_invocation name: (identifier) @fn) @hit",
        "csharp": "(invocation_expression\n   function: (member_access_expression expression: (identifier) @mod\n                                       name: (identifier) @fn)\n   arguments: (argument_list . (argument (_) @arg))) @hit",
        "kotlin": "[(call_expression (navigation_expression (_) (identifier) @fn)\n                  (value_arguments . (value_argument (_) @arg)))\n (call_expression (identifier) @fn (value_arguments . (value_argument (_) @arg)))] @hit"
      },
      "functionPatterns": {
        "python": "^(load|loads|Unpickler)$",
        "ruby": "^(load|load_file)$",
        "php": "^unserialize$",
        "java": "^readObject$",
        "csharp": "^(Deserialize|UnsafeDeserialize)$",
        "kotlin": "^readObject$"
      },
      "modulePatterns": {
        "python": "^(pickle|cPickle|dill|shelve|yaml|marshal)$",
        "ruby": "^(Marshal|YAML|Psych)$",
        "csharp": "^(BinaryFormatter|NetDataContractSerializer|SoapFormatter|LosFormatter|ObjectStateFormatter)$"
      }
    },
