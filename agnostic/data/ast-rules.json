      "argumentPatterns": {
        "php": "(?i)^['\"]\\s*location\\s*:"
      },
      "safeArgumentPatterns": {
        "python": "^(url_for|reverse|reverse_lazy|request\\.url_for)\\(",
        "ruby": "^(\\w+_(path|url)(\\(.*\\))?|@\\w+|:back)$",
        "csharp": "^Url\\.(Action|RouteUrl|Content|Page)\\("
      }
    }
  ]
}
