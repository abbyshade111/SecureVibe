# No trailing slash: a symlink named node_modules (as a worktree uses) is a file to git, and "node_modules/" only
# matches directories, so one was committed twice by accident. Without the slash it matches both.
node_modules
dist/
workspace/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
web/dist/
.claude/
# evaluation harness: results are per-machine records, baselines are shared
evals/results/
