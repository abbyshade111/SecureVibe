# Supply-chain settings for SecureVibe itself; the generated apps get the same treatment in their own .npmrc.
#
# ignore-scripts stops a package running code of its own while being installed, which is the usual way a
# compromised package reaches a computer. One package genuinely needs its install script: esbuild, which fetches
# its binary, and which tsx (the server) and vite (the web app) both use. So `npm install` is followed by one
# explicit rebuild of that single package — `npm run rebuild-tools`, which `npm start` reminds you about if the
# binary is missing. Nothing else is trusted to run at install time.
ignore-scripts=true
# Wait a week before installing a newly published version: a compromised release is usually found within days.
min-release-age=7
fund=false
audit=false
update-notifier=false
