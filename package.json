{
  "name": "securevibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "npm run lint -w server",
    "self-assess": "npm run self-assess -w server",
    "eval": "npm run eval -w server --",
    "verify": "npm run verify -w server --",
    "rebuild-tools": "npm rebuild esbuild --foreground-scripts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3"
  }
}
