{
  "scenario": "refusal-mid-stream",
  "description": "The model works normally for one turn, then declines on a turn that also carries a write. The write in the refusing turn must not happen.",
  "model": "claude-opus-5",
  "turns": [
    {
      "id": "msg_mid_1",
      "role": "assistant",
      "model": "claude-opus-5",
      "stop_reason": "tool_use",
      "content": [
        {
          "type": "tool_use",
          "id": "tu_ok_write",
          "name": "write_file",
          "input": {
            "path": "src/features/notes/routes.ts",
            "content": "// Generated by SecureVibe (AI-generated) - run test-run\nexport const notes = true;\n"
          }
        }
      ],
      "usage": { "input_tokens": 12000, "output_tokens": 300, "cache_creation_input_tokens": 9000 }
    },
    {
      "id": "msg_mid_2",
      "role": "assistant",
      "model": "claude-opus-5",
      "stop_reason": "refusal",
      "stop_details": { "type": "refusal", "category": "cyber", "explanation": "Declined part-way through the turn." },
      "content": [
        { "type": "text", "text": "Adding the second file…" },
        {
          "type": "tool_use",
          "id": "tu_refused_write",
          "name": "write_file",
          "input": {
            "path": "src/features/notes/service.ts",
            "content": "// this half-written file must never reach the disk"
          }
        }
      ],
      "usage": { "input_tokens": 600, "output_tokens": 180, "cache_read_input_tokens": 9000 }
    }
  ]
}
