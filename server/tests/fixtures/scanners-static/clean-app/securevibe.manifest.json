  "writablePaths": ["src/features/**"],
  "allowedImports": ["express", "helmet", "zod", "ejs", "pino", "node:*", "./*", "../*"],
  "controls": [],
  "conventions": [],
  "testMode": {
    "envFlag": "SECUREVIBE_TEST_MODE",
    "readyLinePrefix": "{\"securevibe\":\"listening\"",
    "routesEndpoint": "/__securevibe/routes",
    "seededUsers": []
  }
}
