# SecureVibe settings. Copy this file to .env (or use Settings → "Your AI service" in the app, which writes it).
# A blank value means "use the default".

# Your Anthropic API key. Without one, SecureVibe runs in preview mode (no AI).
ANTHROPIC_API_KEY=
# Other AI services (Settings can store these too).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Set to "off" to run without AI even when a key is present.
SECUREVIBE_AI=
# Where projects, settings and logs live (default: ./workspace).
SECUREVIBE_HOME=
# Port for the local web app (default: 4173).
SECUREVIBE_PORT=
# Open the browser on start (default: 1; set 0 to skip).
SECUREVIBE_OPEN_BROWSER=
# Log level: info (default), debug, warn.
SECUREVIBE_LOG_LEVEL=
