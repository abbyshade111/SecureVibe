ndColumn":45,"endLine":47,"snippet":{"text":"    return requests.get(request.args[\"url\"]).text"},"startColumn":12,"startLine":47}}}],"message":{"text":"There's an HTTP request made with requests, but the raise_for_status() utility method isn't used. This can result in request errors going unnoticed and your code behaving in unexpected ways, such as if your authorization API returns a 500 error while you're only checking for a 401."},"properties":{},"ruleId":"python.requests.best-practice.use-raise-for-status.use-raise-for-status"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":45,"endLine":47,"snippet":{"text":"    return requests.get(request.args[\"url\"]).text"},"startColumn":12,"startLine":47}}}],"message":{"text":"Detected a 'requests' call without a timeout set. By default, 'requests' calls wait until the connection is closed. This means a 'requests' call without a timeout will hang the program if a response is never received. Consider setting a timeout for all 'requests'."},"properties":{},"ruleId":"python.requests.best-practice.use-timeout.use-timeout"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":61,"endLine":52,"snippet":{"text":"    return requests.get(\"https://example.com\", verify=False).text"},"startColumn":12,"startLine":52}}}],"message":{"text":"There's an HTTP request made with requests, but the raise_for_status() utility method isn't used. This can result in request errors going unnoticed and your code behaving in unexpected ways, such as if your authorization API returns a 500 error while you're only checking for a 401."},"properties":{},"ruleId":"python.requests.best-practice.use-raise-for-status.use-raise-for-status"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalL