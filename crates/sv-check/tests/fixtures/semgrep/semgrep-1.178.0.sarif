pen(os.path.join(\"/srv/files\", request.args[\"name\"])).read()"},"startColumn":12,"startLine":60}}}],"message":{"text":"Data from request is passed to os.path.join() and to open(). This is a path traversal vulnerability, which can lead to sensitive data being leaked. To mitigate, consider using os.path.abspath or os.path.realpath or Path library."},"properties":{},"ruleId":"python.django.security.injection.path-traversal.path-traversal-join.path-traversal-join"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":66,"endLine":60,"snippet":{"text":"    return open(os.path.join(\"/srv/files\", request.args[\"name\"])).read()"},"startColumn":12,"startLine":60}}}],"message":{"text":"Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."},"properties":{},"ruleId":"python.flask.security.injection.path-traversal-open.path-traversal-open"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":66,"endLine":60,"snippet":{"text":"    return open(os.path.join(\"/srv/files\", request.args[\"name\"])).read()"},"startColumn":12,"startLine":60}}}],"message":{"text":"Missing 'encoding' parameter. 'open()' uses device locale encodings by default, corrupting files with special characters. Specify the encoding to ensure cross-platform support when opening files in text mode (e.g. encoding=\"utf-8\")."},"properties":{},"ruleId":"python.lang.best-practice.unspecified-open-encoding.unspecified-open-encoding"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/main.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":12,"endLine":10,"snippet":{"text":"\t\"math/rand\""},"startColumn":3,"startLine":10}