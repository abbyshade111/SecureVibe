  "medium": [
    {
      "id": "inj.m.system-prompt-mention",
      "pattern": "\\bsystem\\s+prompt\\b",
      "flags": "i",
      "description": "Mentions the system prompt."
    },
    {
      "id": "inj.m.developer-mode-mention",
      "pattern": "\\bdeveloper\\s+mode\\b",
      "flags": "i",
      "description": "Mentions developer mode."
    },
    {
      "id": "inj.m.you-are-now",
      "pattern": "\\byou\\s+are\\s+now\\s+(?:a|an|the|in|my|no\\s+longer)\\b",
      "flags": "i",
      "description": "Persona instruction phrasing."
    },
    {
      "id": "inj.m.from-now-on",
      "pattern": "\\bfrom\\s+now\\s+on\\s+(?:you|your)\\b",
      "flags": "i",
      "description": "Attempts a lasting behaviour change."
    },
    {
      "id": "inj.m.pretend-you-are",
      "pattern": "\\bpretend\\s+(?:that\\s+)?you\\s+(?:are|were|have)\\b",
      "flags": "i",
      "description": "Role-play framing often used for jailbreaks."
    },
    {
      "id": "inj.m.jailbreak",
      "pattern": "\\bjailbreak(?:ed|ing)?\\b",
      "flags": "i",
      "description": "Mentions jailbreaking."
    },
    {
      "id": "inj.m.your-instructions",
      "pattern": "\\b(?:what|which)\\s+(?:are|were)\\s+your\\s+(?:instructions|rules|guidelines)\\b|\\bprint\\s+your\\s+(?:instructions|rules|prompt)\\b",
      "flags": "i",
      "description": "Probes for the model's instructions."
    },
    {
      "id": "inj.m.rules-do-not-apply",
      "pattern": "\\b(?:rules|restrictions|guidelines|policies)\\s+(?:do\\s+not|don't|no\\s+longer)\\s+apply\\b",
      "flags": "i",
      "description": "Claims rules no longer apply."
    },
    {
      "id": "inj.m.hypothetical-bypass",
      "pattern": "\\bhypothetically\\b[^.\\n]{0,40}\\b(?:you\\s+(?:could|can|would)|no\\s+rules|without\\s+rules)\\b",
      "flags": "i",
      "description": "Hypothetical framing to bypass rules."
    },
    {
      "id": "inj.m.confidential-instructions",
      "pattern": "\\b(?:confidential|hidden|secret)\\s+(?:instructions|prompt|configuration)\\b",
      "flags": "i",
      "description": "Refers to hidden instructions."
    },
    {
      "id": "inj.m.base64-hint",
      "pattern": "\\b(?:decode|execute|run|follow)\\s+(?:this|the\\s+following)\\s+(?:base64|encoded|hex)\\b",
      "flags": "i",
      "description": "Asks to act on encoded content."
    },
    {
      "id": "inj.m.markdown-image-exfil",
      "pattern": "!\\[[^\\]]*\\]\\(https?://[^)]+\\)",
      "flags": "i",
      "description": "Markdown image link, a known data-exfiltration channel."
    },
    {
      "id": "inj.m.stop-being",
      "pattern": "\\bstop\\s+being\\s+(?:an?\\s+)?(?:ai|assistant|helpful|safe|careful)\\b",
      "flags": "i",
      "description": "Asks the model to drop its role."
    },
    {
      "id": "inj.m.human-or-ai-probe",
      "pattern": "\\bare\\s+you\\s+(?:really\\s+)?(?:an?\\s+)?(?:ai|bot|language\\s+model)\\b[^.\\n]{0,30}\\b(?:ignore|prove|bypass)\\b",
      "flags": "i",
      "description": "Identity probe paired with a bypass request."
    },
    {
      "id": "inj.m.obey-me-instead",
      "pattern": "\\bobey\\s+(me|my\\s+(instructions|orders|commands|rules))\\b",
      "flags": "i",
      "description": "Asks the assistant to obey the writer rather than its own instructions."
    },
    {
      "id": "inj.m.instead-of-your-developer",
      "pattern": "\\binstead\\s+of\\s+(your|the)\\s+(developer|operator|system|owner|instructions|rules)\\b",
      "flags": "i",
      "description": "Asks the assistant to follow the writer in place of its operator."
    },
    {
      "id": "inj.m.respond-only-with",
      "pattern": "\\brespond\\s+only\\s+with\\s+the\\s+word\\b",
      "flags": "i",
      "description": "Tries to force a fixed reply, a common probe for instruction override."
    }
  ]
}
